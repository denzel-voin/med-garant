# ─── База данных ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medgarant"

# ─── JWT (generate: openssl rand -base64 48) ────────────────────────────────
JWT_ACCESS_SECRET="replace-me-with-a-random-64-char-string-access"
JWT_REFRESH_SECRET="replace-me-with-a-random-64-char-string-refresh"

# ─── OpenRouter AI ──────────────────────────────────────────────────────────
OPENROUTER_API_KEY="sk-......."
OPENROUTER_TIMEOUT_MS="15000"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
