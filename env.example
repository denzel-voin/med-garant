# ─── База данных ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medgarant"

# ─── JWT ────────────────────────────────────────────────────────────────────
# Генерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# ─── AI ─────────────────────────────────────────────────────────────────
